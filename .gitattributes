# 统一换行符，避免 Windows 与 Linux 协作时整文件 diff
* text=auto

# Shell 脚本必须保持 LF，否则在 Linux 容器里会报 bad interpreter
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Java / Vue 源码在 Windows 上保持 CRLF 不影响编译
*.java  text eol=crlf
*.ts    text eol=crlf
*.vue   text eol=crlf

# 二进制资源不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.woff  binary
*.woff2 binary
